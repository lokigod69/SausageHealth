# Production example. Do not commit actual keys or credentials.
SH_ENV=production
SH_ORIGIN=https://your-private-domain.example
SH_DATA_DIR=/data

# Off by default. Enabling sends explicitly selected notes/text exports to OpenRouter.
SH_AI_ENABLED=0
SH_AI_KEY=
# Choose an exact model supporting JSON mode. Validate using real store examples first.
SH_AI_MODEL=
# A call cap, NOT a monetary budget. Also set a provider-side key spending limit.
SH_AI_DAILY_CALLS=20

# Off by default. Enabling lets the owner and store operators read the Loyverse
# catalogue from the Items page. GET only: this never writes to the POS, never
# registers a webhook and never runs on a schedule.
SH_LOYVERSE_ENABLED=0
# Leave empty to use the private admin file .data/loyverse-access.json instead.
# The credential stays on the server. Never deploy it to the browser or a URL.
SH_LOYVERSE_TOKEN=
# Map Loyverse store ids to workspace stores. An unmapped store stays
# unattributed rather than being assumed to be a particular shop.
# Example: {"01234567-89ab-cdef-0123-456789abcdef":"sausage"}
SH_LOYVERSE_STORE_MAP=
# Bounds on the account's 300-requests-per-300-seconds limit. Not a money budget.
SH_LOYVERSE_COOLDOWN_SECONDS=60
SH_LOYVERSE_DAILY_SYNCS=24
# How far back sales are counted, rounded down to whole weeks (default 28 = 4 weeks).
SH_LOYVERSE_SALES_DAYS=28
# Shared secret for the once-a-day scheduled read in vercel.json. Without it the
# endpoint answers 404 to everyone, including signed-in owners.
CRON_SECRET=
