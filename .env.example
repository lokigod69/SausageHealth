# Production example. Do not commit actual keys or credentials.
SH_ENV=production
SH_ORIGIN=https://your-private-domain.example
SH_DATA_DIR=/data

# Off by default. Enabling sends explicitly selected notes/text exports to OpenRouter.
SH_AI_ENABLED=0
SH_AI_KEY=
# Choose an exact model supporting JSON mode. Validate using real store examples first.
SH_AI_MODEL=
# A call cap, NOT a monetary budget. Also set a provider-side key spending limit.
SH_AI_DAILY_CALLS=20
